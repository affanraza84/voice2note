# ==============================================================================
# VOICE2NOTE — ENVIRONMENT CONFIGURATION
# ==============================================================================
#
# Voice2Note runs in two distinct operating modes:
#
# 1. LOCAL DEVELOPMENT MODE (Default)
#    - 100% private, offline, air-gapped
#    - Local disk audio storage (./data/audio)
#    - Local SQLite database (./data/voice2note.db)
#    - Local Whisper speech-to-text (in-process ONNX tiny.en)
#    - Local Ollama LLM (http://127.0.0.1:11434 with llama3.2)
#    - Local MiniLM embeddings (in-process ONNX all-MiniLM-L6-v2)
#    - NO API keys or external services required.
#
# 2. PRODUCTION SERVERLESS MODE (e.g., Vercel / Cloud Functions)
#    - Persistent object storage for audio files (Vercel Blob)
#    - Production database or volume storage (SQLITE_DB_PATH)
#    - Remote OpenAI-compatible or Groq inference for serverless environments
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PERSISTENT OBJECT STORAGE (Required for Production Deployments)
# ------------------------------------------------------------------------------
# In serverless environments like Vercel, the local filesystem (/var/task) is read-only
# and ephemeral. Voice notes uploaded in production must be stored in persistent
# object storage. Set your Vercel Blob read/write token below:
BLOB_READ_WRITE_TOKEN=

# Optional: Override storage provider manually ('blob' or 'local')
# STORAGE_PROVIDER=blob

# ------------------------------------------------------------------------------
# 2. DATABASE PERSISTENCE (Optional / Advanced)
# ------------------------------------------------------------------------------
# On localhost, Voice2Note defaults to ./data/voice2note.db.
# In serverless environments, it falls back to /tmp/voice2note-data/voice2note.db.
# For persistent SQLite across cold starts, specify a mounted persistent volume path:
# SQLITE_DB_PATH=/mnt/storage/voice2note.db

# ------------------------------------------------------------------------------
# 3. AI INFERENCE — PRODUCTION MODE
# ------------------------------------------------------------------------------
# Local Ollama (127.0.0.1:11434) cannot be reached from cloud serverless containers.
# For production deployments, provide an API key for any OpenAI-compatible provider
# (Groq, Together AI, OpenAI, DeepSeek, or a public tunnel to your local Ollama):
AI_API_KEY=
# Or specify GROQ_API_KEY directly for ultra-fast Llama & Whisper inference:
# GROQ_API_KEY=

# Base URL for LLM completions (defaults to https://api.openai.com/v1, or Groq if GROQ_API_KEY is set)
# AI_BASE_URL=https://api.groq.com/openai/v1

# Target LLM model name (defaults to llama-3.3-70b-versatile on Groq or gpt-4o-mini on OpenAI)
# AI_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 4. REMOTE SPEECH TRANSCRIPTION (Optional in Production)
# ------------------------------------------------------------------------------
# In serverless environments without FFmpeg binaries, remote Whisper can transcribe
# user-uploaded WebM/MP3/WAV files with zero host dependencies.
# Uses GROQ_API_KEY or AI_API_KEY automatically if set.
# SPEECH_MODEL=whisper-large-v3-turbo
# SPEECH_BASE_URL=https://api.groq.com/openai/v1
